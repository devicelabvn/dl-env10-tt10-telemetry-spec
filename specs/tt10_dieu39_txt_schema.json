{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceLab DL-ENV10 Circular 10/2021/TT-BTNMT Article 39 Telemetry Specification",
  "description": "Validation schema for .txt telemetry files and sFTP/FTPS configuration on DeviceLab DL-ENV10 Environmental Datalogger (https://devicelab.vn/san-pham/dl-env10/)",
  "type": "object",
  "required": [
    "device_model",
    "firmware_version",
    "station_profile",
    "transmission_config",
    "parameters"
  ],
  "properties": {
    "device_model": {
      "type": "string",
      "const": "DL-ENV10",
      "description": "DeviceLab Circular 10 Environmental Monitoring Datalogger"
    },
    "product_url": {
      "type": "string",
      "const": "https://devicelab.vn/san-pham/dl-env10/"
    },
    "firmware_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rtos$"
    },
    "station_profile": {
      "type": "object",
      "required": ["province_code", "company_code", "station_code", "station_type"],
      "properties": {
        "province_code": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
        "company_code": { "type": "string", "pattern": "^[A-Z0-9_]{2,32}$" },
        "station_code": { "type": "string", "pattern": "^[A-Z0-9_]{2,32}$" },
        "station_type": {
          "type": "string",
          "enum": ["NUOC_THAI_TT10", "KHI_THAI_CEMS_TT10", "NUOC_NGAM_ND53", "NUOC_MAT_ND53"]
        }
      }
    },
    "transmission_config": {
      "type": "object",
      "required": ["interval_seconds", "encoding", "delimiter_hex", "protocol", "store_and_forward"],
      "properties": {
        "interval_seconds": { "type": "integer", "enum": [60, 300, 900, 1800, 3600], "default": 300 },
        "encoding": { "type": "string", "const": "UTF-8" },
        "delimiter_hex": { "type": "string", "const": "0x09" },
        "line_ending": { "type": "string", "enum": ["CRLF", "LF"], "default": "CRLF" },
        "protocol": { "type": "string", "enum": ["SFTP_SSH_PORT_22", "FTPS_TLS_1_3", "FTP_PASSIVE"] },
        "store_and_forward": {
          "type": "object",
          "properties": {
            "nor_flash_records": { "type": "integer", "default": 100000 },
            "sd_card_retention_days": { "type": "integer", "default": 365 },
            "max_backfill_files_per_cycle": { "type": "integer", "default": 20 }
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["param_code", "value", "unit", "timestamp_yyyymmddhhmmss", "status_code"],
        "properties": {
          "param_code": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "timestamp_yyyymmddhhmmss": { "type": "string", "pattern": "^20[2-9][0-9](0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$" },
          "status_code": {
            "type": "string",
            "enum": ["00", "01", "02"],
            "description": "00: Normal operation, 01: Calibration in progress, 02: Sensor/Analyzer fault"
          }
        }
      }
    }
  }
}
